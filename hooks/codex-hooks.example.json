{
  "description": "AgentAim lifecycle bridge",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider codex", "timeout": 1 }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider codex", "timeout": 1 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider codex", "timeout": 1 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider codex", "timeout": 1 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider codex", "timeout": 1 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider codex", "timeout": 1 }] }
    ]
  }
}
