{
  "description": "AgentAim Windows lifecycle bridge",
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"%LOCALAPPDATA%\\AgentAim\\AgentAimHook.exe\" --provider codex", "timeout": 1 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "\"%LOCALAPPDATA%\\AgentAim\\AgentAimHook.exe\" --provider codex", "timeout": 1 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "\"%LOCALAPPDATA%\\AgentAim\\AgentAimHook.exe\" --provider codex", "timeout": 1 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "\"%LOCALAPPDATA%\\AgentAim\\AgentAimHook.exe\" --provider codex", "timeout": 1 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"%LOCALAPPDATA%\\AgentAim\\AgentAimHook.exe\" --provider codex", "timeout": 1 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"%LOCALAPPDATA%\\AgentAim\\AgentAimHook.exe\" --provider codex", "timeout": 1 }] }]
  }
}
