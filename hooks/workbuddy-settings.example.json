{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider workbuddy", "timeout": 1 }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider workbuddy", "timeout": 1 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider workbuddy", "timeout": 1 }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider workbuddy", "timeout": 1 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider workbuddy", "timeout": 1 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"/ABSOLUTE/PATH/TO/AgentAim.app/Contents/MacOS/AgentAimHook\" --provider workbuddy", "timeout": 1 }] }
    ]
  }
}
